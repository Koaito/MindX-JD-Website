# Copy sang .env khi chạy local (python app.py) — KHÔNG dùng để deploy
# Vercel, deploy Vercel set trực tiếp trong Project Settings > Environment
# Variables (không đọc file .env).

# URL + API key của backend Scrap JD (deploy trên Render)
CRAWLER_API_URL=https://scrap-jd-api.onrender.com
CRAWLER_API_KEY=

# Dùng để ký session cookie Flask — BẮT BUỘC đổi giá trị thật khi deploy,
# KHÔNG dùng giá trị mặc định trong code (app.py dòng SECRET_KEY).
# Lưu ý: tên biến phải là SECRET_KEY (khớp app.py: os.environ.get("SECRET_KEY", ...)).
# Trước đây file này ghi nhầm là FLASK_SECRET_KEY khiến deploy production vô tình
# dùng key mặc định "mindx-ss-dev-key" (lộ công khai trong repo) để ký session cookie.
SECRET_KEY=

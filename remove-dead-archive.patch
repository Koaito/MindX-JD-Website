-@app.route("/data-management/import/<string:entity_type>/confirm", methods=["POST"])
-@staff_required
-def data_management_import_confirm(entity_type):
-    """Bước 2: nhận resolution map (JSON string trong 1 input ẩn, xem
-    data_management.html — JS gom lựa chọn từng dòng thành 1 mảng trước
-    khi submit) + import_note bắt buộc -> gọi backend confirm."""
-    if entity_type not in db_data.IMPORT_EXPORT_ENTITY_TYPES:
-        abort(404)
-
-    preview_id = request.form.get("preview_id", "")
-    import_note = request.form.get("import_note", "").strip()
-    resolutions_raw = request.form.get("resolutions", "[]")
-
-    if not import_note:
-        flash("Vui lòng nhập ghi chú (import note) trước khi xác nhận.", "error")
-        return redirect(url_for("data_management", entity=entity_type, tab="import", preview=preview_id))
-
-    import json
-    try:

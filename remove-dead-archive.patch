-# ---------------------------------------------------------------------------
-# Data Management — Export / Import hàng loạt (Job/Company/Contact)
-#
-# 2 bước cho Import: (1) upload file -> preview (xem conflict, dòng cần
-# chọn company, dòng lỗi) -> (2) staff xác nhận resolution cho từng dòng
-# + bắt buộc nhập import_note -> confirm chạy thật. Toàn bộ state của
-# bước preview nằm ở BACKEND (import_previews, TTL 1h) — trang này chỉ
-# giữ preview_id trên URL (?preview=...), không lưu gì ở session Flask,
-# để refresh trang giữa chừng không mất preview (miễn còn hạn).
-# ---------------------------------------------------------------------------
-
-@app.route("/data-management")
-@staff_required
-def data_management():
-    """Trang chọn entity (Job/Company/Contact) + tab Export/Import.
-
-    Query params:
-      entity: "job" | "company" | "contact" (mặc định "job") — cho phép
-        trỏ thẳng từ nút Import/Export ở jobs.html/companies.html/
-        contacts.html (đợt 2, xem README/chat) qua ?entity=...
-      tab: "export" | "import" (mặc định "export")
-      preview: preview_id — nếu có, load lại preview đã tạo (vd sau khi
-        submit resolution 1 dòng bị lỗi, hoặc F5 giữa chừng) thay vì bắt
-        upload lại file.
-    """
-    entity_type = request.args.get("entity", "job")
-    if entity_type not in db_data.IMPORT_EXPORT_ENTITY_TYPES:
-        entity_type = "job"
-    tab = request.args.get("tab", "export")
-    if tab not in ("export", "import"):
-        tab = "export"
-
-    access_token, _ = _auth_tokens_from_session()
-    preview = None
-    preview_id = request.args.get("preview", "")
-    if preview_id:
-        try:
-            preview = db_data.get_import_preview(access_token, entity_type, preview_id)
-            if preview is None:
-                flash("Bản xem trước đã hết hạn hoặc không tồn tại — vui lòng tải file lên lại.", "error")
-        except CrawlerAPIError as exc:
-            flash(str(exc), "error")
-
-    return render_template(
-        "data_management.html",
-        entity_type=entity_type,
-        entity_types=db_data.IMPORT_EXPORT_ENTITY_TYPES,
-        entity_labels=db_data.IMPORT_EXPORT_ENTITY_LABELS,
-        tab=tab,
-        preview=preview,
-        preview_id=preview_id,
-    )
-
-
-@app.route("/data-management/export/<string:entity_type>")
-@staff_required
-def data_management_export(entity_type):
-    """Tải file export — gọi trực tiếp bằng GET (link <a>) thay vì form
-    POST vì đây thuần là tải xuống, không có input người dùng ngoài
-    format. crawler_client.export_entity() dùng POST khi gọi BACKEND
-    (đúng contract đã chốt /export/{entity_type} là POST) — route Flask
-    này chỉ là lớp trung chuyển, phương thức HTTP ở 2 tầng không nhất
-    thiết phải giống nhau."""
-    if entity_type not in db_data.IMPORT_EXPORT_ENTITY_TYPES:
-        abort(404)
-    file_format = request.args.get("format", "xlsx")
-    if file_format not in ("xlsx", "csv"):
-        file_format = "xlsx"
-
-    access_token, _ = _auth_tokens_from_session()

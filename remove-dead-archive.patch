-        )
-    except CrawlerAPIError as exc:
-        flash(str(exc), "error")
-        return redirect(url_for("data_management", entity=entity_type, tab="export"))
-
-    return Response(
-        content,
-        mimetype=content_type,
-        headers={"Content-Disposition": f'attachment; filename="{filename}"'},
-    )

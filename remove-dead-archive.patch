-    if status == "ALL":
-        status_filter = ""  # value đặc biệt -> KHÔNG lọc gì, xem cả 2 trạng thái
-    elif status:
-        status_filter = status  # đã chọn cụ thể (Đã đóng/Đang tuyển)
-    else:
-        status_filter = "Đang tuyển"  # mặc định khi chưa chọn gì
-
-    try:

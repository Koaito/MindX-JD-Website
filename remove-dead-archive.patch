-    get_engagement_stats())."""
-    today = datetime.now().date()
-    this_y, this_m = today.year, today.month
-    last_y, last_m = (today.year, today.month - 1) if today.month > 1 else (today.year - 1, 12)
-
-    def _in_month(raw_date, y, m):
